{
  "name": "@zaafran/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./money": {
      "types": "./src/money.ts",
      "default": "./dist/money.js"
    },
    "./order-types": {
      "types": "./src/order-types.ts",
      "default": "./dist/order-types.js"
    },
    "./pricing": {
      "types": "./src/pricing.ts",
      "default": "./dist/pricing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@zaafran/config": "workspace:*",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
