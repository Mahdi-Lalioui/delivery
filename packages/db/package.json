{
  "name": "@zaafran/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./auth": {
      "types": "./src/auth.ts",
      "default": "./dist/auth.js"
    },
    "./platform": {
      "types": "./src/platform/repository.ts",
      "default": "./dist/platform/repository.js"
    },
    "./promotions": {
      "types": "./src/promotions/repository.ts",
      "default": "./dist/promotions/repository.js"
    },
    "./billing": {
      "types": "./src/billing.ts",
      "default": "./dist/billing.js"
    },
    "./database": {
      "types": "./src/database.ts",
      "default": "./dist/database.js"
    },
    "./geography": {
      "types": "./src/geography.ts",
      "default": "./dist/geography.js"
    },
    "./public-feed": {
      "types": "./src/public-feed.ts",
      "default": "./dist/public-feed.js"
    },
    "./service-area": {
      "types": "./src/service-area.ts",
      "default": "./dist/service-area.js"
    },
    "./media": {
      "types": "./src/media.ts",
      "default": "./dist/media.js"
    },
    "./menu-category": {
      "types": "./src/menu-category.ts",
      "default": "./dist/menu-category.js"
    },
    "./menu-moderation": {
      "types": "./src/menu-moderation.ts",
      "default": "./dist/menu-moderation.js"
    },
    "./menu-item": {
      "types": "./src/menu-item.ts",
      "default": "./dist/menu-item.js"
    },
    "./menu-option-group": {
      "types": "./src/menu-option-group.ts",
      "default": "./dist/menu-option-group.js"
    },
    "./menu-preview": {
      "types": "./src/menu-preview.ts",
      "default": "./dist/menu-preview.js"
    },
    "./menu-price": {
      "types": "./src/menu-price.ts",
      "default": "./dist/menu-price.js"
    },
    "./merchant-hours": {
      "types": "./src/merchant-hours.ts",
      "default": "./dist/merchant-hours.js"
    },
    "./merchant-profile-photos": {
      "types": "./src/merchant-profile-photos.ts",
      "default": "./dist/merchant-profile-photos.js"
    },
    "./merchant": {
      "types": "./src/merchant.ts",
      "default": "./dist/merchant.js"
    },
    "./merchant-staff": {
      "types": "./src/merchant-staff.ts",
      "default": "./dist/merchant-staff.js"
    },
    "./migrate": {
      "types": "./src/migrate.ts",
      "default": "./dist/migrate.js"
    },
    "./menu-import": {
      "types": "./src/menu-import.ts",
      "default": "./dist/menu-import.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=../../.env src/cli.ts migrate",
    "db:seed": "node --env-file-if-exists=../../.env src/cli.ts seed",
    "db:reset": "node --env-file-if-exists=../../.env src/cli.ts reset"
  },
  "dependencies": {
    "@zaafran/contracts": "workspace:*",
    "@zaafran/domain": "workspace:*",
    "drizzle-orm": "0.45.4",
    "postgres": "4.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@zaafran/config": "workspace:*",
    "@zaafran/media": "workspace:*",
    "graphile-worker": "0.18.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
