  "common": {
    "font-display": "var(--font-poppins, Poppins), var(--font-ibm-plex-sans-arabic, system-ui), system-ui, sans-serif",
    "font-ui": "var(--font-poppins, Poppins), var(--font-ibm-plex-sans-arabic, system-ui), system-ui, sans-serif",
    "font-numbers": "var(--font-poppins, Poppins), system-ui, sans-serif",
