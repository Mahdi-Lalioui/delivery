    "letter-spacing-micro": "0.04em",
    "text-transform-micro": "uppercase",
    "page-padding": "var(--space-16)",
    "container-width": "1200px",
    "touch-target-min": "44px",
    "touch-target-customer-primary": "52px",
    "touch-target-operations-primary": "56px",
    "touch-target-operations-gap": "var(--space-12)",
    "focus-ring-width": "2px",
    "focus-ring-offset": "2px",
    "link-underline-width": "2px",
    "link-underline-offset": "3px",
    "gradient-golden-hour": "linear-gradient(160deg, #0B3D2E, #00A37A)",
    "gradient-route": "linear-gradient(var(--color-accent), var(--color-mint))",
    "glass-blur": "16px",
    "glass-bg": "color-mix(in srgb, var(--color-bg) 72%, transparent)",
    "film-grain-opacity": "0.03"
  },
  "elevation": {
    "light": {
      "shadow-e1": "0 1px 2px rgb(11 61 46 / .06), 0 2px 8px rgb(11 61 46 / .05)",
      "shadow-e2": "0 2px 6px rgb(11 61 46 / .06), 0 12px 32px rgb(11 61 46 / .10)",
      "shadow-e3": "0 4px 12px rgb(11 61 46 / .08), 0 28px 56px rgb(11 61 46 / .16)",
      "elevation-border-width": "0px"
    },
    "dark": {
      "shadow-e1": "0 1px 2px rgb(0 0 0 / .4)",
      "shadow-e2": "0 2px 6px rgb(0 0 0 / .35), 0 12px 32px rgb(0 0 0 / .35)",
      "shadow-e3": "0 4px 12px rgb(0 0 0 / .4), 0 28px 56px rgb(0 0 0 / .5)",
      "elevation-border-width": "1px"
    }
  },
  "arabic": {
    "properties": {
      "font-display": "var(--font-ibm-plex-sans-arabic, 'IBM Plex Sans Arabic'), var(--font-poppins, Poppins), system-ui, sans-serif",
      "font-ui": "var(--font-ibm-plex-sans-arabic, 'IBM Plex Sans Arabic'), var(--font-poppins, Poppins), system-ui, sans-serif",
      "letter-spacing-display-xl": "normal",
      "letter-spacing-micro": "normal",
      "text-transform-micro": "none"
    },
    "fontSizeIncrement": "1px",
    "lineHeightMultiplier": 1.15
  },
  "widePage": {
    "minWidth": "400px",
    "padding": "var(--space-20)"
  }
