    "container-width": "1200px",
    "touch-target-min": "44px",
    "touch-target-customer-primary": "52px",
    "touch-target-operations-primary": "56px",
    "touch-target-operations-gap": "var(--space-12)",
    "focus-ring-width": "2px",
    "focus-ring-offset": "2px",
    "link-underline-width": "2px",
    "link-underline-offset": "3px",
    "gradient-golden-hour": "linear-gradient(#F6AE3E, #C2410C, #2A1E14)",
    "gradient-route": "linear-gradient(var(--color-primary), var(--color-harissa))",
    "glass-blur": "16px",
    "glass-bg": "color-mix(in srgb, var(--color-bg) 72%, transparent)",
    "film-grain-opacity": "0.03"
  },
  "elevation": {
    "light": {
      "shadow-e1": "0 1px 2px rgb(22 19 15 / .06)",
      "shadow-e2": "0 1px 2px rgb(22 19 15 / .05), 0 8px 24px rgb(22 19 15 / .08)",
      "shadow-e3": "0 2px 6px rgb(22 19 15 / .06), 0 24px 48px rgb(22 19 15 / .14)",
      "elevation-border-width": "0px"
    },
    "dark": {
      "shadow-e1": "none",
      "shadow-e2": "none",
      "shadow-e3": "none",
      "elevation-border-width": "1px"
    }
  },
  "arabic": {
    "properties": {
      "font-display": "var(--font-noto-naskh-arabic, 'Noto Naskh Arabic'), serif",
      "font-ui": "var(--font-ibm-plex-sans-arabic, 'IBM Plex Sans Arabic'), system-ui, sans-serif",
      "letter-spacing-display-xl": "normal",
      "letter-spacing-micro": "normal",
      "text-transform-micro": "none"
    },
    "fontSizeIncrement": "1px",
    "lineHeightMultiplier": 1.15
  },
  "widePage": {
    "minWidth": "400px",
    "padding": "var(--space-20)"
  }
