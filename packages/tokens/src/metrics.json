  "common": {
    "font-display": "var(--font-fraunces, Fraunces), Georgia, serif",
    "font-ui": "var(--font-inter, Inter), system-ui, sans-serif",
    "font-numbers": "var(--font-inter, Inter), system-ui, sans-serif",
