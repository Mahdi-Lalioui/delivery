    },
    "./health": {
      "types": "./src/health.ts",
      "default": "./dist/health.js"
    },
    "./media": {
      "types": "./src/media.ts",
      "default": "./dist/media.js"
    },
    "./menu": {
      "types": "./src/menu.ts",
      "default": "./dist/menu.js"
    },
    "./menu-price": {
      "types": "./src/menu-price.ts",
      "default": "./dist/menu-price.js"
    },
    "./merchant": {
      "types": "./src/merchant.ts",
      "default": "./dist/merchant.js"
    },
    "./merchant-staff": {
      "types": "./src/merchant-staff.ts",
