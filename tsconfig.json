{
  "extends": "@zaafran/config/tsconfig/base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "tooling/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts",
    "vitest.domain.config.ts",
    "packages/config/vitest.ts",
    "vitest.integration.config.ts",
    "vitest.search.config.ts",
    "e2e/**/*.ts",
    "packages/config/src/brand.ts"
  ]
}
