{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["ZAAFRAN_API_ORIGIN", "ZAAFRAN_TILE_ORIGIN", "ZAAFRAN_PREVIEW_DEMO", "VERCEL_ENV"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "DATABASE_URL",
        "PORT",
        "API_HOST",
        "API_PORT",
        "API_TRUSTED_PROXY",
        "AUTH_PUBLIC_ORIGIN",
        "AUTH_OTP_KEY",
        "AUTH_TOTP_KEY",
        "MEDIA_STORAGE_ROOT",
        "HEIC_DECODER_PATH",
        "WORKER_CONCURRENCY"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
