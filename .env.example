# Local synthetic Compose credentials. Use unique secrets for hosted environments.
DATABASE_URL=postgresql://zaafran:zaafran_dev_only@127.0.0.1:5432/zaafran_dev

# The integration harness only accepts a loopback URL for zaafran_test.
DATABASE_URL_TEST=postgresql://zaafran:zaafran_dev_only@127.0.0.1:5432/zaafran_test

# API listener. Keep it on loopback for local development.
API_HOST=127.0.0.1
API_PORT=3002
AUTH_PUBLIC_ORIGIN=http://127.0.0.1:3000
# Optional self-hosted OSRM. Compose uses http://osrm:5000.
# OSRM_INTERNAL_ORIGIN=http://127.0.0.1:5000
# Optional local web build override for the national Martin overlay.
# ZAAFRAN_TILE_ORIGIN=http://127.0.0.1:3001
# Generate two independent values with openssl rand -hex 32 and store them only in .env.
AUTH_OTP_KEY=
AUTH_TOTP_KEY=
# Optional HTTPS gateway for sign-in, account deletion and staff invitations. Set both.
# AUTH_SMS_WEBHOOK_URL=https://sms.example.com/send
# AUTH_SMS_WEBHOOK_TOKEN=
# Twilio alternative to the webhook. Configure all three in the API secret file.
# AUTH_TWILIO_ACCOUNT_SID=
# AUTH_TWILIO_AUTH_TOKEN=
# AUTH_TWILIO_FROM=AWID
# Optional Resend email sign-in. Configure both in the API secret file.
# AUTH_RESEND_API_KEY=
# AUTH_RESEND_FROM=auth@example.com
# Set API_TRUSTED_PROXY only on deployments using a known Caddy address or narrow subnet.
# API_TRUSTED_PROXY=192.0.2.12/32

# Number of Graphile jobs a worker process handles at once.
WORKER_CONCURRENCY=2

# Absolute path to the private local disk volume shared by the API and worker.
# Defaults to a directory under the OS temp folder when unset.
# MEDIA_STORAGE_ROOT=/var/zaafran/media

# Absolute path to the bounded HEVC decoder executable for worker HEIC jobs.
# HEIC_DECODER_PATH=/usr/local/bin/zaafran-heic-decode

# Optional HTTPS gateway for customer order-status SMS. Set both in the worker secret store.
# ORDER_SMS_WEBHOOK_URL=https://sms.example.com/send
# ORDER_SMS_WEBHOOK_TOKEN=

# Web Push. Use the same public key in the API and worker. Keep the private key in worker secrets only.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com
