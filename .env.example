# Local synthetic Compose credentials. Use unique secrets for hosted environments.
DATABASE_URL=postgresql://zaafran:zaafran_dev_only@127.0.0.1:5432/zaafran_dev

# The integration harness only accepts a loopback URL for zaafran_test.
DATABASE_URL_TEST=postgresql://zaafran:zaafran_dev_only@127.0.0.1:5432/zaafran_test

# API listener. Keep it on loopback for local development.
API_HOST=127.0.0.1
API_PORT=3002
AUTH_PUBLIC_ORIGIN=http://127.0.0.1:3000
# Generate two independent values with openssl rand -hex 32 and store them only in .env.
AUTH_OTP_KEY=
AUTH_TOTP_KEY=
# Set API_TRUSTED_PROXY only on deployments using a known Caddy address or narrow subnet.
# API_TRUSTED_PROXY=192.0.2.12/32

# Number of Graphile jobs a worker process handles at once.
WORKER_CONCURRENCY=2
